# Copy to .env values into your host's environment variables. NEVER commit real values.
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourdomain.com
ADMIN_URL=manage-shabi/
OWNER_USERNAME=owner
# OWNER_PASSWORD is read only once by `createowner` (or you will be prompted)
LOW_STOCK_THRESHOLD=3
DB_PATH=/path/on/persistent/disk/db.sqlite3
MEDIA_ROOT=/path/on/persistent/disk/media
